{
  "name": "epona",
  "version": "2.7.0",
  "description": "Dark Ages game launcher",
  "main": "./out/main/index.js",
  "author": "Hybrasyl Maintainers <hybrasyl@eris.co>",
  "homepage": "https://github.com/eriscorp/epona",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint . --fix",
    "lint:check": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage --coverage.provider=v8 --coverage.include=src/**",
    "test:watch": "vitest",
    "e2e": "npm run build && playwright test",
    "e2e:only": "playwright test",
    "start": "electron-vite preview -- --trace-warnings",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "postinstall": "electron-builder install-app-deps",
    "rebuild": "npx @electron/rebuild -f -w da-win32",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:win": "npm run build && electron-builder --win",
    "build:portable": "npm run build && electron-builder --win",
    "build:mac": "npm run build && electron-builder --mac --config.beforeBuild=scripts/noop-before-build.cjs",
    "build:linux": "npm run build && electron-builder --linux AppImage --config.beforeBuild=scripts/noop-before-build.cjs"
  },
  "_dependenciesNote": [
    "electron-builder copies EVERY `dependencies` entry into app.asar verbatim.",
    "Only main and preload are externalized (externalizeDepsPlugin); the renderer",
    "config has none, so vite already bundles every UI library into out/renderer.",
    "Anything renderer-only listed here therefore ships TWICE. Keep this list to",
    "what main/preload actually require at run time.",
    "da-win32 is easy to get wrong: it is loaded via createRequire(), not a static",
    "import, AND it is rollup-external, so it is NOT bundled and must be present in",
    "node_modules at run time. A grep for import/require will not find it."
  ],
  "dependencies": {
    "da-win32": "file:packages/da-win32",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config": "^2.1.0",
    "@electron-toolkit/eslint-config-prettier": "^3.0.0",
    "@electron/rebuild": "^4.0.1",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@eslint/js": "^9.39.4",
    "@fontsource/cinzel": "^5.2.8",
    "@fontsource/cinzel-decorative": "^5.2.8",
    "@fontsource/crimson-pro": "^5.2.8",
    "@mui/icons-material": "^9.1.1",
    "@mui/material": "^9.1.2",
    "@playwright/test": "^1.61.1",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^4.1.9",
    "electron": "^41.1.0",
    "electron-builder": "^26.8.1",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.8.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-icons": "^5.6.0",
    "vite": "^6.4.1",
    "vitest": "^4.1.5",
    "zustand": "^5.0.14"
  }
}
